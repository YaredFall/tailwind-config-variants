{
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.mjs"
            },
            "./postcss": {
                "import": "./dist/postcss.mjs",
                "require": "./dist/postcss.cjs"
            }
        }
    },
    "name": "@tailwind-config-variants/core",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "tsdown",
        "prepack": "pnpm build"
    },
    "license": "MIT",
    "packageManager": "pnpm@10.12.1",
    "files": [
        "dist"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./postcss": "./src/postcss/index.ts"
    },
    "devDependencies": {
        "@types/node": "^24",
        "scule": "^1.3.0",
        "tailwindcss": "^3.4 || ^4.0"
    },
    "peerDependencies": {
        "tailwindcss": "^3.4 || ^4.0"
    },
    "dependencies": {
        "jiti": "^2.6.1",
        "postcss": "^8.5.8"
    }
}
